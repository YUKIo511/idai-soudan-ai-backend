{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "基本プロフィール（spec §1）",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "エディタ補完用のスキーマ参照。検証では無視する。"
    },
    "character": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "display_name": {
      "$ref": "common.schema.json#/$defs/localizedText"
    },
    "real_name": {
      "$ref": "common.schema.json#/$defs/localizedText"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "別名"
    },
    "nicknames": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "愛称"
    },
    "birth": {
      "type": "object",
      "properties": {
        "date": {
          "$ref": "common.schema.json#/$defs/partialDate"
        },
        "approx": {
          "type": "boolean",
          "default": false
        },
        "place": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/sourceRef"
          }
        }
      },
      "additionalProperties": false
    },
    "death": {
      "type": "object",
      "properties": {
        "date": {
          "$ref": "common.schema.json#/$defs/partialDate"
        },
        "approx": {
          "type": "boolean",
          "default": false
        },
        "place": {
          "type": "string"
        },
        "cause": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/sourceRef"
          }
        }
      },
      "additionalProperties": false
    },
    "nationality": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "国籍（時代により変遷する場合は複数）"
    },
    "origin_country": {
      "type": "string",
      "description": "出身国"
    },
    "era": {
      "type": "string",
      "description": "活躍した時代（例: 20世紀後半 / 幕末〜明治）"
    },
    "era_range": {
      "$ref": "common.schema.json#/$defs/dateRange"
    },
    "occupations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "職業"
    },
    "titles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "肩書き"
    },
    "organizations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "start": {
            "$ref": "common.schema.json#/$defs/partialDate"
          },
          "end": {
            "$ref": "common.schema.json#/$defs/partialDate"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "family": {
      "type": "array",
      "description": "家族構成。詳細な関係は relationships.json に、ここは一覧のみ。",
      "items": {
        "type": "object",
        "properties": {
          "relation": {
            "type": "string",
            "description": "父/母/兄/姉/妻/夫/子 など"
          },
          "name": {
            "type": "string"
          },
          "person_id": {
            "$ref": "common.schema.json#/$defs/localId",
            "description": "relationships.json のエントリID（あれば）"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "relation"
        ],
        "additionalProperties": false
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "institution": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "start": {
            "$ref": "common.schema.json#/$defs/partialDate"
          },
          "end": {
            "$ref": "common.schema.json#/$defs/partialDate"
          },
          "completed": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "institution"
        ],
        "additionalProperties": false
      }
    },
    "mentors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "師匠"
    },
    "students": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "弟子"
    },
    "main_regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "主要な活動地域"
    },
    "one_line": {
      "type": "string",
      "description": "一言紹介（一覧表示用）"
    },
    "summary": {
      "type": "string",
      "description": "200〜400字の人物要約。RAGで常時投入する。"
    },
    "speaking_style": {
      "type": "object",
      "description": "回答生成時の話し方再現に使用。史料上の制約は caveats に明記する。",
      "properties": {
        "language": {
          "type": "string",
          "description": "主に用いた言語"
        },
        "register": {
          "type": "string",
          "description": "文体・敬体/常体・フォーマリティ"
        },
        "tone": {
          "type": "string"
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "口癖・修辞・比喩の傾向など"
        },
        "example_phrases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caveats": {
          "type": "string",
          "description": "例: 日常会話の逐語記録は乏しく、口調の再現には限界がある"
        },
        "first_person": {
          "type": "string",
          "description": "dialogue モードで本人が使う一人称（既定「私」。例: 「僕」「わし」「余」）"
        },
        "sentence_length": {
          "type": "string",
          "enum": ["very_short", "short", "medium"],
          "description": "dialogue モードの返信の長さ目安（既定 short = 80〜180字）"
        },
        "dialogue_style": {
          "type": "string",
          "enum": ["interactive", "direct", "socratic"],
          "description": "dialogue モードの会話スタイル（interactive=質問で終える／direct=助言中心／socratic=問い返し多め）"
        },
        "persona_tone": {
          "type": "string",
          "description": "dialogue モードで前面に出すトーンの短い語（例: calm_direct / passionate / warm / blunt）"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceRef"
      }
    }
  },
  "required": [
    "character",
    "display_name",
    "summary"
  ],
  "additionalProperties": false
}
