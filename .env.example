# 偉人相談AI — バックエンド環境変数のサンプル
# 使い方: このファイルを .env にコピーして値を入れる（.env は git 管理外）
#   cp .env.example .env
# ここに入れる値はすべて「バックエンド専用」。Expo / アプリ側には絶対に置かないこと。

# ---- LLM プロバイダ切替（config.yaml より優先）----
# fake | ollama | cloudflare | anthropic | openai
KB_LLM_PROVIDER=ollama

# ---- Cloudflare Workers AI（本番用）----
# ダッシュボード右上メニュー等で確認できる Account ID
CLOUDFLARE_ACCOUNT_ID=
# Workers AI の権限を持つ API トークン（My Profile > API Tokens で発行）
CLOUDFLARE_API_TOKEN=
# 使用モデルの一時上書き（通常は config.yaml の llm.cloudflare.model を使う）
# KB_CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ---- CORS（本番はアプリ/配信元のオリジンだけに絞る）----
# 例: KB_CORS_ORIGINS=https://your-app.example.com
KB_CORS_ORIGINS=*

# ---- 管理用（任意）----
# KB_ADMIN_TOKEN=

# ---- ローカル Ollama（開発用。本番では未使用）----
# KB_OLLAMA_MODEL=qwen3:8b
# KB_OLLAMA_BASE_URL=http://localhost:11434
