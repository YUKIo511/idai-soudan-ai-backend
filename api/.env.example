# API / RAG の環境変数。実運用では OS の環境変数に設定する（このファイルはコミットしない）。

# --- プロバイダ切替（config.yaml より優先）---
# KB_EMBEDDINGS_PROVIDER=openai
# KB_VECTORSTORE_BACKEND=chroma
# KB_LLM_PROVIDER=anthropic

# --- LLM API キー（フロントには絶対に出さない。バックエンドのみ）---
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=...

# --- API 運用 ---
# KB_CORS_ORIGINS=*                 # 本番はフロントのオリジンを明示（例: https://example.com）
# KB_ADMIN_TOKEN=change-me          # /admin/reload を保護（未設定なら誰でも実行可＝開発用）
